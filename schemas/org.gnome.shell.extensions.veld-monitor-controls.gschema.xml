<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="veld-monitor-controls">
  <schema id="org.gnome.shell.extensions.veld-monitor-controls"
          path="/org/gnome/shell/extensions/veld-monitor-controls/">
    <key name="placement" type="s">
      <default>'above-volume'</default>
      <summary>Where to place the brightness slider</summary>
    </key>

    <key name="backend" type="s">
      <default>'auto'</default>
      <summary>DDC backend</summary>
    </key>

    <key name="update-mode" type="s">
      <default>'live'</default>
      <summary>When to send brightness writes</summary>
    </key>

    <key name="show-contrast" type="b">
      <default>true</default>
      <summary>Show contrast controls</summary>
    </key>

    <key name="show-volume" type="b">
      <default>true</default>
      <summary>Show monitor audio controls</summary>
    </key>

    <key name="show-input" type="b">
      <default>true</default>
      <summary>Show input source controls</summary>
    </key>

    <key name="show-color" type="b">
      <default>true</default>
      <summary>Show color preset controls</summary>
    </key>

    <key name="show-rgb" type="b">
      <default>false</default>
      <summary>Show RGB gain controls</summary>
    </key>

    <key name="allow-zero-brightness" type="b">
      <default>false</default>
      <summary>Allow brightness to reach zero</summary>
    </key>

    <key name="min-brightness-percent" type="i">
      <default>1</default>
      <range min="0" max="50"/>
      <summary>Minimum brightness percentage</summary>
    </key>

    <key name="write-interval-ms" type="i">
      <default>80</default>
      <range min="0" max="1000"/>
      <summary>Minimum time between writes to the same control</summary>
    </key>

    <key name="verify-writes" type="b">
      <default>false</default>
      <summary>Ask ddcutil to verify every write</summary>
    </key>

    <key name="show-osd" type="b">
      <default>true</default>
      <summary>Show on-screen display while adjusting</summary>
    </key>

    <key name="brightness-up" type="as">
      <default><![CDATA[['<Control>XF86MonBrightnessUp']]]></default>
      <summary>Increase brightness shortcut</summary>
    </key>

    <key name="brightness-down" type="as">
      <default><![CDATA[['<Control>XF86MonBrightnessDown']]]></default>
      <summary>Decrease brightness shortcut</summary>
    </key>

    <key name="shortcut-step-percent" type="i">
      <default>5</default>
      <range min="1" max="50"/>
      <summary>Brightness shortcut step</summary>
    </key>

    <key name="ddcutil-path" type="s">
      <default>'ddcutil'</default>
      <summary>Path to the ddcutil binary</summary>
    </key>

    <key name="ddcutil-extra-args" type="s">
      <default>''</default>
      <summary>Extra arguments passed to ddcutil</summary>
    </key>

    <key name="sleep-multiplier" type="d">
      <default>1.0</default>
      <range min="0.1" max="10.0"/>
      <summary>ddcutil sleep multiplier</summary>
    </key>

    <key name="hidden-displays" type="as">
      <default>[]</default>
      <summary>Display keys that should not be controlled</summary>
    </key>

    <key name="custom-names" type="a{ss}">
      <default>{}</default>
      <summary>Custom names keyed by display key</summary>
    </key>

    <key name="debug-logging" type="b">
      <default>false</default>
      <summary>Write diagnostic messages to the journal</summary>
    </key>
  </schema>
</schemalist>
